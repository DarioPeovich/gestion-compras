generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model compras_articulos_cache {
  hfsql_articulos_id   Int      @id
  descripcion          String   @db.VarChar(150)
  precio_costo         Decimal? @db.Decimal(19, 6)
  utilidad_lista_1     Decimal? @db.Decimal(6, 2)
  utilidad_lista_2     Decimal? @db.Decimal(6, 2)
  utilidad_lista_3     Decimal? @db.Decimal(6, 2)
  utilidad_lista_4     Decimal? @db.Decimal(6, 2)
  utilidad_lista_5     Decimal? @db.Decimal(6, 2)
  alicuota_iva         Decimal? @db.Decimal(5, 2)
  imp_interno_tipo     Int?
  imp_interno_alicuota Decimal? @db.Decimal(6, 2)
  imp_interno_monto    Decimal? @db.Decimal(19, 6)
  imp_transf_comb      Decimal? @db.Decimal(19, 6)
  imp_dioxido_carbono  Decimal? @db.Decimal(19, 6)
  updated_at_hfsql     DateTime @db.Timestamp(6)
  extra                Json?
  synced_at            DateTime @default(now()) @db.Timestamp(6)
  cod_barras           String?  @db.VarChar(20)

  @@index([cod_barras], map: "idx_compras_articulos_cache_cod_barras")
  @@index([descripcion], map: "idx_compras_articulos_cache_descrip")
  @@index([updated_at_hfsql], map: "idx_compras_articulos_cache_updated")
}

model compras_comprobantes_tipo {
  id                        Int                    @id @default(autoincrement())
  descripcion               String                 @db.VarChar(50)
  descrip_abrev             String                 @db.VarChar(10)
  letra                     String?                @db.Char(1)
  produce                   String?                @db.Char(1)
  factor                    Int                    @default(1) @db.SmallInt
  cbte_fiscal               Boolean                @default(false)
  hfsql_comprobante_tipo_id Int?
  created_at                DateTime               @default(now()) @db.Timestamptz(6)
  compras_comprobantes      compras_comprobantes[]
}

model compras_proveedores {
  id                      Int                       @id @default(autoincrement())
  hfsql_proveedores_id    Int?                      @unique
  razon_social            String                    @db.VarChar(150)
  cuit                    String?                   @db.VarChar(20)
  condicion_pago          String?                   @db.VarChar(50)
  dias_pago               Int?                      @default(0)
  email                   String?                   @db.VarChar(100)
  telefono                String?                   @db.VarChar(30)
  direccion               String?                   @db.VarChar(200)
  contactos               Json?
  activo                  Boolean                   @default(true)
  updated_at_hfsql        DateTime?                 @db.Timestamp(6)
  created_at              DateTime                  @default(now()) @db.Timestamp(6)
  updated_at              DateTime                  @default(now()) @db.Timestamp(6)
  compras_cc_aplicaciones compras_cc_aplicaciones[]
  compras_cc_movimientos  compras_cc_movimientos[]
  compras_comprobantes    compras_comprobantes[]
  compras_ordenes_compra  compras_ordenes_compra[]
  compras_pagos           compras_pagos[]
  compras_remitos         compras_remitos[]

  @@index([activo], map: "idx_compras_proveedores_activo")
  @@index([cuit], map: "idx_compras_proveedores_cuit")
  @@index([hfsql_proveedores_id], map: "idx_compras_proveedores_hfsql")
}

model compras_comprobantes {
  id                                    Int                                     @id @default(autoincrement())
  proveedor_id                          Int
  comprobante_tipo_id                   Int
  punto_venta                           Int                                     @db.SmallInt
  numero_comprobante                    Int
  fecha                                 DateTime                                @db.Date
  fecha_vto                             DateTime?                               @db.Date
  subtotal                              Decimal                                 @default(0) @db.Decimal(14, 2)
  total                                 Decimal                                 @default(0) @db.Decimal(14, 2)
  saldo                                 Decimal                                 @default(0) @db.Decimal(14, 2)
  estado                                String                                  @default("CONFIRMADO") @db.VarChar(20)
  fecha_actualizacion_stock             DateTime?                               @db.Timestamptz(6)
  observaciones                         String?
  usuario_id                            Int
  created_at                            DateTime                                @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime                                @default(now()) @db.Timestamptz(6)
  periodo_fiscal                        String?                                 @db.VarChar(7)
  operacion_id                          String?                                 @unique @db.Uuid
  compras_cc_movimientos                compras_cc_movimientos[]
  compras_comprobantes_tipo             compras_comprobantes_tipo               @relation(fields: [comprobante_tipo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_proveedores                   compras_proveedores                     @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_comprobantes_detalle          compras_comprobantes_detalle[]
  compras_comprobantes_iva_detalle      compras_comprobantes_iva_detalle[]
  compras_comprobantes_tributos_detalle compras_comprobantes_tributos_detalle[]
  compras_remitos_asociados             compras_remitos_asociados[]

  @@unique([proveedor_id, comprobante_tipo_id, punto_venta, numero_comprobante], map: "uix_comprobantes_fiscal")
  @@index([proveedor_id], map: "ix_comprobantes_proveedor")
  @@index([fecha], map: "ix_comprobantes_fecha")
  @@index([estado], map: "ix_comprobantes_estado")
}

model compras_comprobantes_detalle {
  id                   Int                  @id @default(autoincrement())
  comprobante_id       Int
  hfsql_articulos_id   Int?
  articulo_codigo      String?              @db.VarChar(50)
  articulo_descrip     String               @db.VarChar(200)
  cantidad             Decimal              @default(0) @db.Decimal(12, 4)
  precio_costo         Decimal              @default(0) @db.Decimal(14, 4)
  importe_linea        Decimal              @default(0) @db.Decimal(14, 2)
  alicuota_iva         Decimal              @default(0) @db.Decimal(5, 2)
  importe_iva          Decimal              @default(0) @db.Decimal(14, 2)
  importe_icl          Decimal              @default(0) @db.Decimal(14, 2)
  importe_idc          Decimal              @default(0) @db.Decimal(14, 2)
  importe_imp_interno  Decimal              @default(0) @db.Decimal(14, 2)
  compras_comprobantes compras_comprobantes @relation(fields: [comprobante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([comprobante_id], map: "ix_cbte_detalle_comprobante")
}

model compras_comprobantes_iva_detalle {
  id                   Int                  @id @default(autoincrement())
  comprobante_id       Int
  iva_tipo_id          Int
  base_imponible       Decimal              @default(0) @db.Decimal(14, 2)
  importe_iva          Decimal              @default(0) @db.Decimal(14, 2)
  alicuota             Decimal              @default(0) @db.Decimal(5, 2)
  compras_comprobantes compras_comprobantes @relation(fields: [comprobante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([comprobante_id], map: "ix_iva_detalle_comprobante")
}

model compras_comprobantes_tributos_detalle {
  id                   Int                  @id @default(autoincrement())
  comprobante_id       Int
  tributo_id           Int
  base_imponible       Decimal?             @db.Decimal(14, 2)
  importe              Decimal              @default(0) @db.Decimal(14, 2)
  compras_comprobantes compras_comprobantes @relation(fields: [comprobante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([comprobante_id], map: "ix_tributos_detalle_comprobante")
}

model compras_remitos {
  id                        Int                         @id @default(autoincrement())
  proveedor_id              Int
  orden_compra_id           Int?
  fecha                     DateTime                    @default(dbgenerated("CURRENT_DATE")) @db.Date
  deposito_id               Int
  estado                    String                      @default("CONFIRMADO") @db.VarChar(20)
  stock_actualizado         Boolean                     @default(false)
  observaciones             String?
  usuario_id                Int
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @default(now()) @db.Timestamp(6)
  punto_venta               Int
  numero_remito             Int
  operacion_id              String?                     @unique @db.Uuid
  compras_ordenes_compra    compras_ordenes_compra?     @relation(fields: [orden_compra_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_proveedores       compras_proveedores         @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_remitos_asociados compras_remitos_asociados[]
  compras_remitos_detalle   compras_remitos_detalle[]

  @@unique([proveedor_id, punto_venta, numero_remito], map: "uq_compras_remitos_numeracion")
  @@index([estado], map: "idx_compras_remitos_estado")
  @@index([fecha], map: "idx_compras_remitos_fecha")
  @@index([proveedor_id], map: "idx_compras_remitos_proveedor")
}

model compras_remitos_detalle {
  id                 Int             @id @default(autoincrement())
  remito_id          Int
  hfsql_articulos_id Int
  articulo_codigo    String          @db.VarChar(20)
  articulo_descrip   String          @db.VarChar(100)
  cantidad           Decimal         @db.Decimal(14, 3)
  precio_costo       Decimal?        @db.Decimal(19, 6)
  created_at         DateTime        @default(now()) @db.Timestamp(6)
  compras_remitos    compras_remitos @relation(fields: [remito_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([remito_id], map: "idx_compras_remitos_detalle_remito")
}

model compras_remitos_asociados {
  id                   Int                  @id @default(autoincrement())
  comprobante_id       Int
  remito_id            Int
  compras_comprobantes compras_comprobantes @relation(fields: [comprobante_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  compras_remitos      compras_remitos      @relation(fields: [remito_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([comprobante_id, remito_id], map: "uix_remitos_asoc")
  @@index([comprobante_id], map: "ix_remitos_asoc_comprobante")
  @@index([remito_id], map: "ix_remitos_asoc_remito")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model compras_cc_movimientos {
  id                   Int                   @id @default(autoincrement())
  proveedor_id         Int
  comprobante_id       Int?
  pago_id              Int?
  fecha                DateTime              @db.Date
  debito               Decimal               @default(0) @db.Decimal(14, 2)
  credito              Decimal               @default(0) @db.Decimal(14, 2)
  saldo_acumulado      Decimal               @default(0) @db.Decimal(14, 2)
  descripcion          String?               @db.VarChar(200)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  compras_comprobantes compras_comprobantes? @relation(fields: [comprobante_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_pagos        compras_pagos?        @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_proveedores  compras_proveedores   @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([proveedor_id], map: "ix_cc_mov_proveedor")
  @@index([fecha], map: "ix_cc_mov_fecha")
}

model compras_cc_aplicaciones {
  id                  Int                 @id @default(autoincrement())
  proveedor_id        Int
  pago_id             Int?
  nota_credito_id     Int?
  factura_id          Int?
  nota_debito_id      Int?
  importe             Decimal             @db.Decimal(19, 6)
  fecha               DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  usuario_id          Int
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  compras_pagos       compras_pagos?      @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_proveedores compras_proveedores @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([proveedor_id], map: "idx_compras_cc_aplic_proveedor")
  @@index([pago_id], map: "idx_compras_cc_aplic_pago")
  @@index([factura_id], map: "idx_compras_cc_aplic_factura")
  @@index([nota_credito_id], map: "idx_compras_cc_aplic_nota_credito")
  @@index([nota_debito_id], map: "idx_compras_cc_aplic_nota_debito")
}

model compras_pagos {
  id                      Int                       @id @default(autoincrement())
  proveedor_id            Int
  fecha                   DateTime                  @default(dbgenerated("CURRENT_DATE")) @db.Date
  importe_total           Decimal                   @db.Decimal(19, 6)
  saldo                   Decimal                   @default(0) @db.Decimal(19, 6)
  observaciones           String?
  usuario_id              Int
  created_at              DateTime                  @default(now()) @db.Timestamp(6)
  updated_at              DateTime                  @default(now()) @db.Timestamp(6)
  compras_cc_aplicaciones compras_cc_aplicaciones[]
  compras_cc_movimientos  compras_cc_movimientos[]
  compras_proveedores     compras_proveedores       @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_pagos_medios    compras_pagos_medios[]

  @@index([fecha], map: "idx_compras_pagos_fecha")
  @@index([proveedor_id], map: "idx_compras_pagos_proveedor")
  @@index([saldo], map: "idx_compras_pagos_saldo")
}

model compras_pagos_medios {
  id            Int           @id @default(autoincrement())
  pago_id       Int
  medio         String        @db.VarChar(20)
  importe       Decimal       @db.Decimal(19, 6)
  referencia    String?       @db.VarChar(100)
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  compras_pagos compras_pagos @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pago_id], map: "idx_compras_pagos_medios_pago")
}

model compras_ordenes_compra {
  id                             Int                              @id @default(autoincrement())
  proveedor_id                   Int
  fecha                          DateTime                         @default(dbgenerated("CURRENT_DATE")) @db.Date
  fecha_entrega                  DateTime?                        @db.Date
  estado                         String                           @default("BORRADOR") @db.VarChar(20)
  observaciones                  String?
  usuario_id                     Int
  created_at                     DateTime                         @default(now()) @db.Timestamp(6)
  updated_at                     DateTime                         @default(now()) @db.Timestamp(6)
  compras_proveedores            compras_proveedores              @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  compras_ordenes_compra_detalle compras_ordenes_compra_detalle[]
  compras_remitos                compras_remitos[]

  @@index([estado], map: "idx_compras_oc_estado")
  @@index([proveedor_id], map: "idx_compras_oc_proveedor")
}

model compras_ordenes_compra_detalle {
  id                     Int                    @id @default(autoincrement())
  orden_compra_id        Int
  hfsql_articulos_id     Int
  articulo_codigo        String                 @db.VarChar(20)
  articulo_descrip       String                 @db.VarChar(100)
  cantidad               Decimal                @db.Decimal(14, 3)
  precio_unitario        Decimal?               @db.Decimal(19, 6)
  created_at             DateTime               @default(now()) @db.Timestamp(6)
  compras_ordenes_compra compras_ordenes_compra @relation(fields: [orden_compra_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orden_compra_id], map: "idx_compras_ocd_orden")
}

model compras_sync_status {
  proceso              String    @id @db.VarChar(50)
  estado               String    @default("pendiente") @db.VarChar(20)
  cursor_actual        String?   @db.VarChar(50)
  total_estimado       Int?
  registros_procesados Int       @default(0)
  iniciado_en          DateTime? @db.Timestamp(6)
  actualizado_en       DateTime? @db.Timestamp(6)
  finalizado_en        DateTime? @db.Timestamp(6)
  ultimo_error         String?
}
